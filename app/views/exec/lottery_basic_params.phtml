        $lottery_id = isset($this->viewData['lottery_id']) ? $this->viewData['lottery_id'] : "";
        $page = isset($this->viewData['page']) ? $this->viewData['page'] : 1;

        $model = GameManageModel::fetchGameTypesForLottery($lottery_id, $page);

        if ($model['status'] === 'error') {
            echo json_encode(['status' => 'error', 'data' => "Internal Server Error."]);
            return;
        }

        $model = $model['data'];
        $final_results = [];
        $total_count = !empty($model) ? $model[0]->total_count : 0;

        foreach ($model as $data) {
            $lottrytype = $data->name;
            $state = '';

            if ($data->state == 1) {
                $state = "<span class='tag' id='state-{$data->gt_id}'>Turned On</span>";
            } elseif ($data->state == 0) {
                $state = "<span class='tag' id='state-{$data->gt_id}'>Stopped</span>";
            } elseif ($data->state == -1) {
                $state = "<span class='tag' id='state-{$data->gt_id}'>Turned Off</span>";
            }
            // $filename = $data->logo;
           $filename = basename($data->logo);
          
            $localFilePath = $_SERVER['DOCUMENT_ROOT'] . "/admin/app/assets/images/" . $filename;
            $localImageURL = "http://localhost/admin/app/assets/images/" . $filename;
            $publicImageURL = "https://winsstarts.com/chairman_test/app/lottery_images/" . $filename;
           

            $finalImagePath = file_exists($localFilePath) ? $localImageURL : $publicImageURL;
            $final_results[] = [
                "id" => $data->gt_id,
                'sort_weight' => json_decode($data->sort_weight),
                'lottery_id' => $data->lt_id,
                'lottery_image' => $finalImagePath,
                'lottery_name' => $data->name,
                'lottery_type' => $lottrytype,
                'alias' => $data->alias,
                'max_prize_per_bet' => trim($data->maximum_prize_per_bet),
                'max_win' => trim($data->maximum_win_per_issue),
                'max_amt_per_issue' => trim($data->maximum_amount_per_issue),
                'mn_amt_per_issue' => trim($data->minimum_amount_per_issue),
                'clsing' => trim($data->closing_time),
                'state' => $state,
                'logo' => $filename,
            ];
        }

        $results = ['data'=> $final_results, 'totalCount'=>$total_count];
    } catch (Exception $e) {
       $results = ['status' => 'error', 'data' => 'Internal Server Error.'.$e->getMessage()];
