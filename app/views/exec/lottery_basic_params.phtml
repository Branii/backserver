if ($flag == "addlottery") {
    $logoFileName     = $this->viewData['logoFileName'] ?? "";
    $name             = $this->viewData['name'] ?? "";
    $alias            = $this->viewData['alias'] ?? "";
    $gamegroups       = $this->viewData['gamegroups'] ?? "";
    $numberofballs    = $this->viewData['numberofballs'] ?? "";
    $min_ball         = $this->viewData['min_ball'] ?? "";
    $max_ball         = $this->viewData['max_ball'] ?? "";
    $secondsperissue  = $this->viewData['secondsperissue'] ?? "";
    $starttime        = $this->viewData['starttime'] ?? "";
    $stoptime         = $this->viewData['stoptime'] ?? "";
    $lotterymodel     = $this->viewData['lotterymodel'] ?? "";
    $lotteryType      = strtolower($this->viewData['lotteryType'] ?? "");
    $secondsperissue  = is_numeric($secondsperissue) ? (int)$secondsperissue : 0;
    if ($secondsperissue === 0) {
        echo json_encode(['type' => 'error', 'message' => 'Invalid seconds per issue. Cannot divide by zero.']);
        return;
}

    $total_num_issue = floor(86400 / $secondsperissue);

    $gameData = [
        'logoFileName'=>   $logoFileName,
        'name'              => $name,
        'alias'             => $alias ?: $name . $secondsperissue,
        'lottery_type'      => $gamegroups,
        'seconds_per_issue' => $secondsperissue,
        'total_num_issue'   => $total_num_issue,
        'starttime'         => $starttime,
        'stoptime'          => $stoptime,
        'num_of_balls'      => $numberofballs,
        'min_ball'          => $min_ball,
        'max_ball'          => $max_ball,
        'lottery_model'     => $lotterymodel,
        'game_group'        => $lotteryType
    ];
    $result = GameManageModel::createNewGame($gameData, "game_type");
    // echo json_encode($gameData['game_group']);
    echo json_encode($result);

}
